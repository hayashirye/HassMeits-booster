# ============================================================
#  构建产物 —— 不进仓库
#
#  这些是二进制，而且很大（release\ 有 72 MB）。
#  发布成品请用 GitHub Releases：打个 tag，把 install.exe 传到
#  Release 的附件里。不要提交进历史 —— git 的历史只增不减，
#  一旦提交过一次，仓库就永远背着这 72 MB，事后删也删不掉。
#
#  ★ 注意：.gitignore 不支持行尾注释。
#    「release/   # 说明」这种写法里，# 后面整串都算模式的一部分，
#    规则会静默失效。所以说明一律单独占行。
# ============================================================
release/
engine-build/
ValorantBoost.exe

# ------------------------------------------------------------
#  运行期数据 —— 每台机器都不一样，提交上去只会互相覆盖
# ------------------------------------------------------------
# 电源方案原始备份（.pow），引擎运行期自己写的
backup/
# 引擎回滚包（含旧 exe + 任务 XML）
engine-backup-*/
# 引擎日志
boost-log.txt
# 「还原初始设置」的还原点
boost-backup.txt
auto-backup.txt

# ------------------------------------------------------------
#  Flutter / Dart 构建缓存
# ------------------------------------------------------------
flutter-app/build/
flutter-app/.dart_tool/
flutter-app/.flutter-plugins
flutter-app/.flutter-plugins-dependencies
flutter-app/.packages
flutter-app/windows/flutter/ephemeral/
*.iml

# ------------------------------------------------------------
#  编辑器 / 系统
# ------------------------------------------------------------
.vs/
.vscode/
.idea/
*.user
*.suo
Thumbs.db
desktop.ini
